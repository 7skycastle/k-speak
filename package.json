{
  "name": "korean-first-talk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "tsc -b --pretty false",
    "test": "vitest run",
    "audio:manifest": "tsx scripts/audio/generate-audio-manifest.ts",
    "audio:validate": "tsx scripts/audio/validate-audio-assets.ts",
    "audio:placeholder": "tsx scripts/audio/generate-placeholder-audio.ts",
    "audio:voices": "tsx scripts/audio/list-browser-tts-voices.ts",
    "tts:plan": "python tools/tts/generate_audio.py --dry-run",
    "tts:manifest": "python tools/tts/generate_audio.py --write-manifest",
    "tts:validate": "python tools/tts/validate_audio.py",
    "tts:compare:plan": "python tools/tts/generate_comparison_audio.py",
    "tts:compare:manifest": "python tools/tts/generate_comparison_audio.py --write-manifest",
    "tts:compare:generate": "python tools/tts/generate_comparison_audio.py --execute --write-manifest --continue-on-error",
    "supabase:validate": "tsx scripts/supabase/validate-sql.ts",
    "supabase:bundle": "tsx scripts/supabase/bundle-sql.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
